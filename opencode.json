{
  "$schema": "https://opencode.ai/config.json",
  "watcher": {
    "ignore": [
      ".git/**",
      "**/.git/**",
      ".venv/**",
      "**/.venv/**",
      "node_modules/**",
      "**/node_modules/**",
      "target/**",
      "**/target/**",
      "build/**",
      "**/build/**",
      "dist/**",
      "**/dist/**",
      "**/__pycache__/**",
      "**/.pytest_cache/**",
      "**/.mypy_cache/**",
      "**/.ruff_cache/**",
      "**/htmlcov/**",
      "**/coverage/**",
      "**/*.pyc",
      "**/*.npy",
      "**/*.npz",
      "**/*.parquet",
      "**/*.arrow",
      "**/*.safetensors"
    ]
  }
}
